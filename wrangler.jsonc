{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "otakudesk",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  // Newsletter subscribers. Shared with the cron Worker in newsletter/, which
  // sends the weekly issue. Secret RESEND_API_KEY is set with
  // `wrangler secret put` on both Workers and never appears here.
  //
  // CLICKS is the outbound click log written by /go/[slug] (one key per click,
  // no personal data) and read by /api/clicks, which is gated by the
  // ADMIN_TOKEN secret (`wrangler secret put ADMIN_TOKEN`).
  "kv_namespaces": [
    { "binding": "SUBSCRIBERS", "id": "fa3607a7e5814994b5805a7beb4d790e" },
    { "binding": "CLICKS", "id": "a749e2c45b3d4955943a291b462c15ee" }
  ],

  // Custom domains. otakudesk.com is registered in this same Cloudflare
  // account, so the DNS records and the TLS certificate are created and
  // renewed automatically — there is no nameserver change to make.
  //
  // Declared here rather than clicked in the dashboard so the routing is in
  // version control and a rebuild cannot silently lose it.
  //
  // Secrets (AMAZON_TAG, AWIN_AFF_ID) are set with `wrangler secret put` and
  // must never appear in this file - it is committed.
  "routes": [
    { "pattern": "otakudesk.com", "custom_domain": true },
    { "pattern": "www.otakudesk.com", "custom_domain": true }
  ]
}
