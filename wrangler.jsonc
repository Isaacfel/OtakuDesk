{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "otakudesk",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  // Custom domains. otakudesk.com is registered in this same Cloudflare
  // account, so the DNS records and the TLS certificate are created and
  // renewed automatically — there is no nameserver change to make.
  //
  // Declared here rather than clicked in the dashboard so the routing is in
  // version control and a rebuild cannot silently lose it.
  //
  // Secrets (AMAZON_TAG, AWIN_AFF_ID) are set with `wrangler secret put` and
  // must never appear in this file - it is committed.
  "routes": [
    { "pattern": "otakudesk.com", "custom_domain": true },
    { "pattern": "www.otakudesk.com", "custom_domain": true }
  ]
}
